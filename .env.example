# ── Database ───────────────────────────────────────────────────────────────
# Local dev (run `docker compose up db`) — host port 5432
DATABASE_URL=postgresql://athletics:athletics@localhost:5432/athletics
# Password used by the Postgres container (compose reads ${DB_PASSWORD})
DB_PASSWORD=athletics

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# Public base URL of the app
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Multi-user: each registered account is fully isolated. Registration is open by
# default; set to "true" to block new sign-ups after creating your account(s).
DISABLE_REGISTRATION=false

# ── Container image ──────────────────────────────────────────────────────────
# The image docker-compose runs. Leave the default for a local build
# (docker compose up --build), or point to the published image:
#   APP_IMAGE=ghcr.io/<owner>/<repo>:latest
APP_IMAGE=athletics-tracker:local

# ── Seed user (created by `pnpm db:seed`) ────────────────────────────────────
SEED_USER_EMAIL=athlete@example.com
SEED_USER_NAME=Athlete
SEED_USER_PASSWORD=changeme

# ── FIDAL integration ────────────────────────────────────────────────────────
# Your athlete profile URL, stored in settings on seed. Find it on fidal.it.
FIDAL_ATHLETE_URL=https://www.fidal.it/atleta/Your-Name/xxxxxxxx
