# Copy to .env and edit. Only the first three sections need your attention;
# everything below has a working default.

# ── Required ─────────────────────────────────────────────────────────────────

# Session-signing secret. Generate one:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# The first user, managed only from here: change these and restart to update
# the admin's login. Everyone else registers, or is created from the admin area.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ── Where the app is reachable ───────────────────────────────────────────────

# The address you type in the browser, not the container's. Behind a proxy or a
# tunnel this is the public name: https://times.example.com
BETTER_AUTH_URL=http://localhost:3000

# The port on the host. The app always listens on 3000 inside the container.
# APP_PORT=3000

# Other public names the same instance answers to, comma separated. Addresses
# on your own network (192.168.x, 10.x, *.local, localhost) are always accepted,
# so this is only for additional public names.
# TRUSTED_ORIGINS=https://times.example.com,https://times.example.org

# Session cookies are marked Secure when BETTER_AUTH_URL is https, and browsers
# then refuse to keep them over plain http. Set this to false if you also open
# the app by its address on the LAN, where there is no certificate.
# SECURE_COOKIES=false

# ── Database ─────────────────────────────────────────────────────────────────

# Password for the Postgres container.
DB_PASSWORD=times

# Only used when running the app outside Docker (`pnpm dev`). Inside Compose
# the app is told where the database is and ignores this.
DATABASE_URL=postgresql://times:times@localhost:5432/times

# ── Backups ──────────────────────────────────────────────────────────────────

# Off unless you pick an interval. A run writes one JSON export per user into a
# dated folder — the same format Settings → Import reads back.
#   off | daily | weekly | biweekly | monthly | bimonthly | quarterly | yearly
# Intervals are counted in days, so monthly means every 30 days.
BACKUP_SCHEDULE=off

# Where they go. Unset means a Docker volume named "backups". A host directory
# must be writable by uid 1001, the user the app runs as:
#   chown 1001:1001 /mnt/nas/times-backups
# BACKUP_PATH=/mnt/nas/times-backups

# ── Optional ─────────────────────────────────────────────────────────────────

# Block new sign-ups once your accounts exist.
DISABLE_REGISTRATION=false

# The admin page says when a newer release exists, by asking GitHub's public
# release list every few hours. Nothing about you or your training is sent.
# UPDATE_CHECKS=false

# Redis holds the rate-limit windows and a few cached lookups so they survive a
# restart. It runs by default and needs nothing from you. To do without it, set
# this to nothing — the app then keeps the same state in its own memory:
# REDIS_URL=

# Pin the image instead of following latest.
# APP_IMAGE=ghcr.io/mmattia09/times:1.7.0
