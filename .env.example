# ── Database ─────────────────────────────────────────────────────────────────
# Password for the Postgres container.
DB_PASSWORD=times
# Connection string. For local dev against `docker compose up db` use localhost;
# inside Docker Compose the app already points at the db service.
DATABASE_URL=postgresql://times:times@localhost:5432/times

# ── Auth ─────────────────────────────────────────────────────────────────────
# Session-signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Public URL where the app is reachable.
BETTER_AUTH_URL=http://localhost:3000

# ── Admin account ────────────────────────────────────────────────────────────
# The first user. Managed only here: change these and restart to update the
# admin's login. Every other user registers and self-manages in the app.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ── Options ──────────────────────────────────────────────────────────────────
# Set to true to block new sign-ups once your accounts exist.
DISABLE_REGISTRATION=false

# Image to run (built by GitHub Actions, published to GHCR). Uncomment to pin
# a specific version instead of latest:
# APP_IMAGE=ghcr.io/mmattia09/times:v1.0.0
