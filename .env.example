# ── Database ─────────────────────────────────────────────────────────────────
# Password for the Postgres container.
DB_PASSWORD=times
# Connection string. For local dev against `docker compose up db` use localhost;
# inside Docker Compose the app already points at the db service.
DATABASE_URL=postgresql://times:times@localhost:5432/times

# ── Auth ─────────────────────────────────────────────────────────────────────
# Session-signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Public URL where the app is reachable — the address you type in the browser,
# not the container's. Behind a tunnel or a reverse proxy this is the public
# name: https://times.example.com
BETTER_AUTH_URL=http://localhost:3000

# Any other name the same instance answers to, comma separated. Addresses on
# your own network (192.168.x, 10.x, *.local, localhost) are always accepted,
# so this is only for additional *public* names.
# TRUSTED_ORIGINS=https://times.example.com,https://times.example.org

# Session cookies are marked Secure when BETTER_AUTH_URL is https, which means
# the browser drops them over plain http. Set this to false if you also open
# the app by its address on the LAN, where there is no certificate.
# SECURE_COOKIES=false

# ── Admin account ────────────────────────────────────────────────────────────
# The first user. Managed only here: change these and restart to update the
# admin's login. Every other user registers and self-manages in the app.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ── Options ──────────────────────────────────────────────────────────────────
# Set to true to block new sign-ups once your accounts exist.
DISABLE_REGISTRATION=false

# The Settings page tells admins when a newer release exists, by asking GitHub's
# public release list every few hours. Nothing about you or your training is
# sent. Uncomment to stop the server asking at all:
# UPDATE_CHECKS=false

# ── Backups ──────────────────────────────────────────────────────────────────
# Off unless you pick an interval. A run writes one JSON export per user into a
# dated folder — the same format Settings → Import reads back.
#   off | daily | weekly | biweekly | monthly | bimonthly | quarterly | yearly
# An interval is a number of days, so monthly means every 30 days.
BACKUP_SCHEDULE=off

# Where they go. Unset means a Docker volume named "backups". Point this at a
# host directory to keep them on a disk you already back up elsewhere — it must
# be writable by uid 1001, the user the app runs as:
#   chown 1001:1001 /mnt/nas/times-backups
# BACKUP_PATH=/mnt/nas/times-backups

# Image to run (built by GitHub Actions, published to GHCR). Uncomment to pin
# a specific version instead of latest:
# APP_IMAGE=ghcr.io/mmattia09/times:1.5.0
